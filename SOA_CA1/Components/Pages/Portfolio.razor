@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using SOA_CA1.Models
@using SOA_CA1.Services
@inject IPortfolioService PortfolioService
@inject CurrencyPreference CurrencyPreference

<PageTitle>Portfolio</PageTitle>

@if (isLoading)
{
    <section class="portfolio-page" aria-labelledby="portfolio-heading">
        <p role="status">Loading your portfolio...</p>
    </section>
}
else if (errorMessage is not null)
{
    <section class="portfolio-page" aria-labelledby="portfolio-heading">
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    </section>
}
else if (loadedPortfolio is null || loadedPortfolio.Holdings.Count == 0)
{
    <section class="portfolio-page" aria-labelledby="portfolio-heading">
        <h1 id="portfolio-heading">My Portfolio</h1>
        <p class="text-muted mb-0">No holdings have been added yet.</p>
    </section>
}
else
{
var currentPortfolio = loadedPortfolio!;
<section class="portfolio-page" aria-labelledby="portfolio-heading">
    <div class="portfolio-heading">
        <div>
            <p class="eyebrow">Overview</p>
            <h1 id="portfolio-heading">My Portfolio</h1>
            <p class="text-muted mb-0">Track your holdings and performance in one place.</p>
        </div>
        <button class="btn btn-primary" type="button">Add holding</button>
    </div>

    <div class="summary-grid" aria-label="Portfolio summary">
        <article class="summary-card">
            <p class="summary-card__label">Total value</p>
            <p class="summary-card__value num">@FormatMoney(currentPortfolio.TotalValue)</p>
            <p class="summary-card__detail">@currentPortfolio.Holdings.Count holdings</p>
        </article>
        <article class="summary-card">
            <p class="summary-card__label">Total cost</p>
            <p class="summary-card__value num">@FormatMoney(currentPortfolio.TotalCost)</p>
            <p class="summary-card__detail">Initial investment</p>
        </article>
        <article class="summary-card">
            <p class="summary-card__label">Total gain/loss</p>
            <p class="summary-card__value @GetChangeClass(currentPortfolio.TotalGainLoss) num">
                @FormatChange(currentPortfolio.TotalGainLoss)
            </p>
            <p class="summary-card__detail @GetChangeClass(currentPortfolio.TotalGainLoss)">
                @FormatPercent(currentPortfolio.TotalGainLoss, currentPortfolio.TotalCost)
            </p>
        </article>
    </div>

    <div class="portfolio-toolbar">
        <div>
            <h2>Holdings</h2>
            <p class="text-muted mb-0">Live prices are shown in @selectedCurrency.</p>
        </div>
        <div class="portfolio-toolbar__controls">
            <label class="toolbar-field">
                <span>Show values in</span>
                <select class="form-select" aria-label="Display currency" @bind="selectedCurrency" @bind:after="ChangeCurrencyAsync">
                    <option value="USD">USD</option>
                    <option value="EUR">EUR</option>
                    <option value="GBP">GBP</option>
                    <option value="CNY">CNY</option>
                    <option value="JPY">JPY</option>
                </select>
            </label>
        </div>
    </div>

    <div class="holdings-table-container">
        <table class="holdings-table">
            <thead>
                <tr>
                    <th scope="col">
                        <button class="sortable-header" type="button" @onclick="() => SortBy(nameof(SortField.Symbol))">
                            Symbol @SortIndicator(nameof(SortField.Symbol))
                        </button>
                    </th>
                    <th scope="col" class="num">
                        <button class="sortable-header" type="button" @onclick="() => SortBy(nameof(SortField.Quantity))">
                            Quantity @SortIndicator(nameof(SortField.Quantity))
                        </button>
                    </th>
                    <th scope="col" class="num">
                        <button class="sortable-header" type="button" @onclick="() => SortBy(nameof(SortField.BuyPrice))">
                            Buy price @SortIndicator(nameof(SortField.BuyPrice))
                        </button>
                    </th>
                    <th scope="col" class="num">
                        <button class="sortable-header" type="button" @onclick="() => SortBy(nameof(SortField.CurrentPrice))">
                            Current price @SortIndicator(nameof(SortField.CurrentPrice))
                        </button>
                    </th>
                    <th scope="col" class="num">
                        <button class="sortable-header" type="button" @onclick="() => SortBy(nameof(SortField.MarketValue))">
                            Market value @SortIndicator(nameof(SortField.MarketValue))
                        </button>
                    </th>
                    <th scope="col" class="num">
                        <button class="sortable-header" type="button" @onclick="() => SortBy(nameof(SortField.GainLossPercent))">
                            Gain/loss @SortIndicator(nameof(SortField.GainLossPercent))
                        </button>
                    </th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var holding in currentPortfolio.Holdings)
                {
                    <tr>
                        <td>
                            <a class="holding-symbol" href="/stock/@holding.Symbol">@holding.Symbol</a>
                            <span>@holding.Name</span>
                        </td>
                        <td class="num">@holding.Quantity</td>
                        <td class="num">@FormatMoney(holding.BuyPrice * holding.FxRate)</td>
                        <td class="num">@FormatMoney(holding.Quote?.C * holding.FxRate)</td>
                        <td class="num">@FormatMoney(holding.MarketValue)</td>
                        <td class="num @GetChangeClass(holding.GainLoss)">
                            @FormatChange(holding.GainLoss)<br />
                            <small>@FormatPercent(holding.GainLoss, holding.CostBasis)</small>
                        </td>
                        <td><button class="action-button" type="button">Edit</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
}

@code {
    private SOA_CA1.Models.Portfolio? loadedPortfolio;
    private bool isLoading = true;
    private string? errorMessage;
    private string selectedCurrency = "USD";
    private string selectedSortField = "Symbol";
    private bool sortDescending;

    protected override async Task OnInitializedAsync()
    {
        selectedCurrency = CurrencyPreference.CurrentCurrency;
        try
        {
            loadedPortfolio = await PortfolioService.GetPortfolioAsync(selectedCurrency);
            ApplySort();
        }
        catch (ApiException)
        {
            errorMessage = "The portfolio could not be loaded because a market-data service is unavailable.";
        }
        catch (InvalidDataException)
        {
            errorMessage = "The portfolio data could not be read.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The portfolio could not be loaded. Check your network connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeCurrencyAsync()
    {
        CurrencyPreference.SetCurrency(selectedCurrency);
        await ReloadPortfolioAsync();
    }

    private async Task ReloadPortfolioAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            loadedPortfolio = await PortfolioService.GetPortfolioAsync(selectedCurrency);
            ApplySort();
        }
        catch (ApiException)
        {
            errorMessage = "The portfolio could not be loaded because a market-data service is unavailable.";
        }
        catch (InvalidDataException)
        {
            errorMessage = "The portfolio data could not be read.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The portfolio could not be loaded. Check your network connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplySort()
    {
        if (loadedPortfolio is null)
        {
            return;
        }

        loadedPortfolio.Holdings = PortfolioService
            .Sort(loadedPortfolio.Holdings, selectedSortField, sortDescending)
            .ToList();
    }

    private void SortBy(string sortField)
    {
        if (selectedSortField == sortField)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            selectedSortField = sortField;
            sortDescending = false;
        }

        ApplySort();
    }

    private string SortIndicator(string sortField) =>
        selectedSortField == sortField ? (sortDescending ? "▼" : "▲") : "";

    private string FormatMoney(decimal? value) =>
        value is null ? "Unavailable" : FormatCurrency(value.Value);

    private string FormatMoney(decimal value) =>
        FormatCurrency(value);

    private string FormatChange(decimal? value)
    {
        if (value is null)
        {
            return "Unavailable";
        }

        return $"{(value >= 0 ? "▲ +" : "▼ ")}{FormatCurrency(Math.Abs(value.Value))}";
    }

    private string FormatCurrency(decimal value)
    {
        return $"{(value < 0 ? "-" : "")}{CurrencyPreference.GetSymbol(selectedCurrency)}{Math.Abs(value).ToString("N2", CultureInfo.InvariantCulture)}";
    }

    private static string FormatPercent(decimal? gainLoss, decimal costBasis)
    {
        if (gainLoss is null || costBasis == 0m)
        {
            return "Unavailable";
        }

        var percentage = gainLoss.Value / costBasis * 100m;
        return $"{(percentage >= 0 ? "+" : "")}{percentage:F2}%";
    }

    private static string GetChangeClass(decimal? value) =>
        value is null ? "" : value >= 0 ? "gain" : "loss";
}
